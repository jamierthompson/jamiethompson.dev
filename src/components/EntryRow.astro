---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { formatShortDate } from "../lib/formatDate";

/** One entry of either collection in a list: date and category, title, description. */
export interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
}

const { href, title, description, category, pubDate } = Astro.props;
---

<a
  href={href}
  class="group -mx-3 flex flex-col gap-1 rounded-xl px-3 py-3 transition-colors hover:bg-muted/70"
>
  <span class="flex gap-4 text-sm text-muted-foreground">
    <time datetime={pubDate.toISOString()}>{formatShortDate(pubDate)}</time>
    <span>{category}</span>
  </span>
  <span class="font-medium">
    {title}
    <ArrowRight
      aria-hidden="true"
      class="ml-1 inline size-4 -translate-x-1 align-[-0.15em] text-muted-foreground opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100"
    />
  </span>
  <span class="text-muted-foreground">{description}</span>
</a>
