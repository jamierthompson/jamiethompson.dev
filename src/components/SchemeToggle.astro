---
import Moon from "@lucide/astro/icons/moon";
import Sun from "@lucide/astro/icons/sun";
import SunMoon from "@lucide/astro/icons/sun-moon";

/**
 * Color-scheme switcher: a segmented control with one button per mode.
 *
 * "Auto" follows the OS preference live; "Light" and "Dark" pin the scheme.
 * The choice is stored under the `scheme` localStorage key and applied before
 * first paint by the inline script in Base.astro, which must read the same key
 * and values. Icons only; labels are for assistive tech and mirror macOS's
 * Light / Dark / Auto.
 */
const MODES = [
  { value: "light", label: "Light", Icon: Sun },
  { value: "dark", label: "Dark", Icon: Moon },
  { value: "system", label: "Auto", Icon: SunMoon },
] as const;
---

<scheme-toggle
  role="group"
  aria-label="Color scheme"
  class="flex w-fit items-center rounded-md shadow-xs [&:not(:defined)]:hidden"
>
  {MODES.map(({ value, label, Icon }) => (
    <button
      type="button"
      data-scheme={value}
      aria-label={label}
      aria-pressed="false"
      class="inline-flex size-8 items-center justify-center border border-l-0 border-input text-muted-foreground transition-colors first:rounded-l-md first:border-l last:rounded-r-md hover:bg-muted hover:text-foreground focus-visible:z-10 aria-pressed:bg-muted aria-pressed:text-foreground"
    >
      <Icon aria-hidden="true" class="size-4" />
    </button>
  ))}
</scheme-toggle>

<script>
  type Scheme = "light" | "dark" | "system";

  const STORAGE_KEY = "scheme";
  const darkQuery = matchMedia("(prefers-color-scheme: dark)");

  function readScheme(): Scheme {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored === "light" || stored === "dark") return stored;
    } catch {
      // Storage can be blocked; fall through to following the OS.
    }
    return "system";
  }

  function apply(scheme: Scheme) {
    const dark =
      scheme === "dark" || (scheme === "system" && darkQuery.matches);
    document.documentElement.classList.toggle("dark", dark);
  }

  class SchemeToggle extends HTMLElement {
    connectedCallback() {
      this.render(readScheme());
      this.addEventListener("click", (event) => {
        const button = (event.target as Element).closest("[data-scheme]");
        if (!button) return;
        const scheme = button.getAttribute("data-scheme") as Scheme;
        try {
          if (scheme === "system") localStorage.removeItem(STORAGE_KEY);
          else localStorage.setItem(STORAGE_KEY, scheme);
        } catch {
          // Unstorable: the choice still applies for this page view.
        }
        apply(scheme);
        // The header renders one toggle inline and one in the drawer; whichever
        // was clicked, both have to show the choice.
        for (const toggle of document.querySelectorAll<SchemeToggle>(
          "scheme-toggle",
        )) {
          toggle.render(scheme);
        }
      });
    }

    render(scheme: Scheme) {
      for (const button of this.querySelectorAll("[data-scheme]")) {
        button.setAttribute(
          "aria-pressed",
          String(button.getAttribute("data-scheme") === scheme),
        );
      }
    }
  }

  customElements.define("scheme-toggle", SchemeToggle);

  // Auto has to follow the OS live, not only at load.
  darkQuery.addEventListener("change", () => {
    if (readScheme() === "system") apply("system");
  });
</script>
