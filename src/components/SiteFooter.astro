---
import ExternalLink from "./ExternalLink.astro";
import { CONTACT, SITE_NAME } from "../lib/site";

/**
 * One quiet line: the copyright on the left, the contact links on the right,
 * within the page width under a full-width border. On a narrow screen the two
 * stack.
 */
const year = new Date().getUTCFullYear();
---

<footer class="mt-24 border-t text-sm text-muted-foreground">
  <div class="mx-auto flex w-full max-w-page flex-col gap-y-3 px-gutter py-6 sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {SITE_NAME}
    </p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {CONTACT.map(({ href, label }) => (
        <li>
          <ExternalLink
            href={href}
            class="transition-colors hover:text-foreground"
          >
            {label}
          </ExternalLink>
        </li>
      ))}
    </ul>
  </div>
</footer>
