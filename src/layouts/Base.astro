---
import { Font } from "astro:assets";
import PaintBackground from "../components/PaintBackground.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_NAME, SITE_URL } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// `astro check` guards the typed call sites, but nothing enforces props at
// runtime, so a missing title would otherwise die inside `endsWith` — or ship
// as `<title>undefined</title>`.
if (typeof title !== "string") {
  throw new Error("<Base> requires a title.");
}

/**
 * Whitespace is not a description. `description` is `z.string()` in
 * `src/content.config.ts` with no minimum, so `"   "` is schema-valid and a
 * bare `description &&` would ship both tags blank — and a crawler reads an
 * empty `og:description` and believes it.
 */
const pageDescription = description?.trim();

/**
 * Only the pathname is taken: the build's origin comes from `site`, but
 * `astro dev` and `astro preview` serve from localhost, and a canonical that
 * points at localhost is worse than none at all.
 */
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;

/**
 * `og:site_name` names the site and `og:title` names the page (ogp.me
 * §Optional Metadata), so the suffix is dropped for the card and kept in
 * `<title>`. The index title genuinely is the site name; there is no special
 * case for it.
 */
const TITLE_SUFFIX = ` — ${SITE_NAME}`;
const pageTitle = (
  title.endsWith(TITLE_SUFFIX) ? title.slice(0, -TITLE_SUFFIX.length) : title
).trim();
/**
 * `og:title` is required (ogp.me §Basic Metadata) and nothing guarantees a
 * title survives having the suffix cut off it: `title` is `z.string()` in
 * `src/content.config.ts` with no minimum, so `""`, `"   "` and
 * `" — Jamie Thompson"` all reduce to nothing. Failing the build is the point
 * — a page titled after the site is a typo that would otherwise ship.
 */
if (pageTitle === "") {
  throw new Error(
    `<Base> got the title "${title}", which is nothing once the "${TITLE_SUFFIX}" suffix is taken off it. A page needs a title of its own.`,
  );
}

/**
 * `website` is the Open Graph default (ogp.me §Object Types), and it is all
 * this layout can honestly claim: it cannot tell an essay from an index, and
 * `article` would need a prop no call site passes yet.
 */
const OG_TYPE = "website";

/**
 * `summary`, not `summary_large_image`: the site has sample image assets, but
 * no `og:image` yet. A large-image card with no image renders as a
 * blank panel, which is worse than the small card the crawler falls back to.
 */
const TWITTER_CARD = "summary";

/**
 * The browser chrome's color for each scheme: `--background` in
 * `src/styles/global.css`, oklch(1 0 0) and oklch(0.145 0 0), converted to
 * sRGB hex because older engines that read `theme-color` do not parse oklch.
 * The inline script picks between them, so they reach it through `define:vars`.
 */
const THEME_COLOR = { light: "#ffffff", dark: "#0a0a0a" };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* iOS ignores SVG icons and draws transparency as black, so the home
        screen gets an opaque PNG of the same mark. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    {pageDescription && <meta name="description" content={pageDescription} />}
    <meta property="og:type" content={OG_TYPE} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && (
      <meta property="og:description" content={pageDescription} />
    )}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content={TWITTER_CARD} />
    <title>{title}</title>
    {/* Only the upright face is preloaded: it is what every page paints
        first, while italic appears only in prose and can arrive late without
        holding up the first render. */}
    <Font cssVariable="--font-geist-sans" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-geist-mono" />
    {/* One `theme-color`, not a pair keyed on `prefers-color-scheme`: the
        scheme is a class the reader can pin against the OS, and a media
        variant would follow the OS regardless. The light value is the
        default because without JavaScript nothing adds `.dark`. */}
    <meta name="theme-color" content={THEME_COLOR.light} />
    {/* Runs before first paint so a stored or OS-preferred dark scheme never
        flashes light. Must read the key and values SchemeToggle.astro writes.
        It also keeps `theme-color` on the current scheme: watching the
        `dark` class covers the toggle and the OS-following "Auto" mode
        without SchemeToggle having to know the tag exists. */}
    <script is:inline define:vars={{ themeColor: THEME_COLOR }}>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem("scheme");
        } catch {}
        const dark =
          stored === "dark" ||
          (stored !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        root.classList.toggle("dark", dark);

        const meta = document.querySelector('meta[name="theme-color"]');
        if (!meta) return;
        const sync = () =>
          meta.setAttribute(
            "content",
            root.classList.contains("dark")
              ? themeColor.dark
              : themeColor.light,
          );
        sync();
        new MutationObserver(sync).observe(root, {
          attributes: true,
          attributeFilter: ["class"],
        });
      })();
    </script>
  </head>
  <body class="flex min-h-svh flex-col">
    <PaintBackground />
    {/* The header is sticky, so a keyboard user would otherwise tab through
        it on every page before reaching anything. */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:text-sm"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main
      id="main"
      class="mx-auto w-full max-w-page flex-1 px-gutter pt-16 pb-16 md:pt-24"
    >
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
