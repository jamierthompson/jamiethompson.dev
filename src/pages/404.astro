---
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../lib/site";

/** Where a lost reader most likely meant to go: the sections the header names. */
const links = [
  { href: "/", label: "Home" },
  { href: "/writing/", label: "Writing" },
  { href: "/projects/", label: "Projects" },
];
---

<Base
  title={`Not found — ${SITE_NAME}`}
  description="There's no page at this address."
>
  <p class="enter font-mono text-sm text-muted-foreground">404</p>
  <h1 class="enter mt-2 text-3xl font-medium tracking-tight text-balance sm:text-4xl">
    Nothing here yet
  </h1>
  <p class="enter mt-4 max-w-xl text-muted-foreground" style="--stagger: 1">
    You've found a gap in the site. The link might have a typo, the page might
    have moved, or it's something I haven't made yet. Everything that does exist
    is a click away:
  </p>
  <ul class="enter mt-8 flex flex-wrap gap-x-6 gap-y-2" style="--stagger: 2">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="font-medium underline decoration-border underline-offset-[3px] transition-colors hover:decoration-foreground"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</Base>
