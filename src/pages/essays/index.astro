---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const essays = (await getCollection("essays", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Essays — Jamie Thompson"
  description="The longer arguments — essays and case studies."
>
  <h1>Essays</h1>
  <p>The longer arguments — essays and case studies.</p>
  {essays.length === 0 && <p class="muted">First essay in progress.</p>}
  <ul>
    {
      essays.map((essay) => (
        <li>
          <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
          <p class="muted">{essay.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
