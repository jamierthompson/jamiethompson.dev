---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ExternalLink from "../components/ExternalLink.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const essays = (await getCollection("essays", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Jamie Thompson"
  description="Writing about the things I build: short notes holding one idea each, and long-form essays."
>
  <h1>Jamie Thompson</h1>
  <p>
    I'm a software engineer, and this is where I write about the things I build,
    in two forms. <a href="/notes/">Notes</a> hold one idea each, written when I
    run into it. <a href="/essays/">Essays</a> make the longer arguments,
    usually out of notes that piled up first.
  </p>
  <p>
    Start with{" "}
    <a href="/essays/directing-agents/">
      Directing AI agents: how I ship production code I didn't write
    </a>{" "}
    — the system of governance and measurement that makes it work. Its working
    rules are public at{" "}
    <ExternalLink href="https://github.com/jamierthompson/agent-conventions">
      agent-conventions
    </ExternalLink>
    . That system is the first body of work here, not the last.
  </p>

  {notes.length > 0 && (
    <section>
      <h2>Notes</h2>
      <ul>
        {notes.slice(0, 5).map((note) => (
          <li>
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {essays.length > 0 && (
    <section>
      <h2>Essays</h2>
      <ul>
        {essays.slice(0, 5).map((essay) => (
          <li>
            <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
