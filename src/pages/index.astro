---
import Base from "../layouts/Base.astro";
import ExternalLink from "../components/ExternalLink.astro";
import ProjectCard from "../components/ProjectCard.astro";
import EntryRow from "../components/EntryRow.astro";
import { getFeatured } from "../lib/featured";
import { SITE_NAME } from "../lib/site";

/** Which entries, and in what order, is `src/content/featured.yaml`. */
const { projects, writing } = await getFeatured();
---

<Base
  title={SITE_NAME}
  description="Design engineer. Projects, and writing about the things I build."
>
  <header class="enter flex items-center gap-3">
    {/* Initials until there's a photo: put one in src/assets/ and swap this
        for an <Image> from astro:assets, keeping the size and the rounding. */}
    <span
      aria-hidden="true"
      class="grid size-10 shrink-0 place-items-center rounded-full bg-foreground font-mono text-xs font-medium tracking-tight text-background"
    >
      JT
    </span>
    <div>
      <h1 class="font-medium">{SITE_NAME}</h1>
      <p class="text-muted-foreground">Design engineer</p>
    </div>
  </header>

  <div class="enter prose mt-8" style="--stagger: 1">
    <p>
      I'm a design engineer, and this is where I keep the things I build and the
      writing that comes out of building them.
    </p>
    <p>
      The working rules I give AI agents are public at{" "}
      <ExternalLink href="https://github.com/jamiethompsondesign/agent-conventions">
        agent-conventions
      </ExternalLink>
      .
    </p>
  </div>

  {projects.length > 0 && (
    <section
      class="enter mt-16"
      style="--stagger: 2"
      aria-labelledby="projects"
    >
      <h2 id="projects" class="mb-4 font-medium">
        Projects
      </h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {writing.length > 0 && (
    <section class="enter mt-16" style="--stagger: 3" aria-labelledby="writing">
      <h2 id="writing" class="mb-4 font-medium">
        Writing
      </h2>
      <ul class="max-w-2xl">
        {writing.map((post) => (
          <li>
            <EntryRow href={`/writing/${post.id}/`} {...post.data} />
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
