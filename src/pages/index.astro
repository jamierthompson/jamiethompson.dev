---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const experiments = (
  await getCollection("experiments", ({ data }) => !data.draft)
).sort((a, b) => b.data.started.valueOf() - a.data.started.valueOf());
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const essays = (await getCollection("essays", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Jamie Thompson"
  description="AI-product experiments built in public — the data, the field notes, and the essays they produce."
>
  <h1>Jamie Thompson</h1>
  <p>
    I build experiments in the AI-product space in public and publish the data.
    <a href="/experiments/">Experiments</a> carry the numbers, <a href="/notes/"
      >field notes</a
    >
    capture the lessons the day they land, and <a href="/essays/">essays</a> make
    the arguments. The system I direct coding agents with is public too:
    <a href="https://github.com/jamierthompson/agent-conventions"
      >agent-conventions</a
    >, improved in the open.
  </p>

  {
    experiments.length > 0 && (
      <section>
        <h2>Experiments</h2>
        <ul>
          {experiments.slice(0, 5).map((experiment) => (
            <li>
              <a href={`/experiments/${experiment.id}/`}>
                {experiment.data.title}
              </a>
              <span class="muted"> — {experiment.data.status}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    notes.length > 0 && (
      <section>
        <h2>Latest field notes</h2>
        <ul>
          {notes.slice(0, 5).map((note) => (
            <li>
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    essays.length > 0 && (
      <section>
        <h2>Essays</h2>
        <ul>
          {essays.slice(0, 5).map((essay) => (
            <li>
              <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
