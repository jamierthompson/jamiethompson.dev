---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/formatDate";
import { buildBacklinkIndex, type LinkedEntry } from "../../lib/wikilinks";

export const getStaticPaths = (async () => {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}) satisfies GetStaticPaths;

const { note } = Astro.props;
const { Content } = await render(note);

const published = [
  ...(await getCollection("notes", ({ data }) => !data.draft)),
  ...(await getCollection("essays", ({ data }) => !data.draft)),
];
const linkedEntries: LinkedEntry[] = published.map((entry) => ({
  collection: entry.collection,
  id: entry.id,
  title: entry.data.title,
  body: entry.body ?? "",
}));
const backlinks = buildBacklinkIndex(linkedEntries).get(note.id) ?? [];
---

<Base
  title={`${note.data.title} — Jamie Thompson`}
  description={note.data.description}
>
  <article>
    <h1>{note.data.title}</h1>
    <p class="muted">
      <time datetime={note.data.pubDate.toISOString()}>
        {formatDate(note.data.pubDate)}
      </time>
    </p>
    <Content />
  </article>

  {
    backlinks.length > 0 && (
      <aside aria-labelledby="backlinks-heading">
        <hr />
        <h2 id="backlinks-heading">Referenced by</h2>
        <ul>
          {backlinks.map((source) => (
            <li>
              <a href={`/${source.collection}/${source.id}/`}>{source.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</Base>
