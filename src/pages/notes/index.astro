---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Field notes — Jamie Thompson"
  description="Short, atomic lessons written the day they land — one idea per note, linked to the evidence."
>
  <h1>Field notes</h1>
  <p>
    One idea per note, written the day it lands: a rule, a lesson, an
    observation. Notes link to each other and to the experiments and essays
    behind them; each note lists what references it.
  </p>
  <ul>
    {
      notes.map((note) => (
        <li>
          <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          <p class="muted">{note.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
