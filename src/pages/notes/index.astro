---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Field notes — Jamie Thompson"
  description="Worked cases from directing coding agents: what failed, what it proved, what changed."
>
  <h1>Field notes</h1>
  <p>
    Worked cases, one per note: what failed, what it proved, and what rule
    changed because of it. Notes link to each other; each note lists what
    references it.
  </p>
  <ul>
    {
      notes.map((note) => (
        <li>
          <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          <p class="muted">{note.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
