---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import ExternalLink from "../../components/ExternalLink.astro";
import Entry from "../../layouts/Entry.astro";
import { published } from "../../lib/collections";
import { formatDate } from "../../lib/formatDate";
import { getBacklinks } from "../../lib/references";

export const getStaticPaths = (async () => {
  const projects = await published("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content, headings } = await render(project);
const backlinks = await getBacklinks("projects", project.id);
const { title, description, category, pubDate, url, cover } = project.data;
---

<Entry
  title={title}
  description={description}
  headings={headings}
  backlinks={backlinks}
  back={{ href: "/projects/", label: "Projects" }}
>
  <Fragment slot="meta">
    <p class="mt-4 text-muted-foreground">{description}</p>
    <p class="mt-2 flex justify-center gap-4 text-sm text-muted-foreground">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span>{category}</span>
    </p>
    {url && (
      <p class="mt-3">
        <ExternalLink
          href={url}
          class="text-sm text-muted-foreground underline decoration-border underline-offset-[3px] transition-colors hover:text-foreground"
        >
          {new URL(url).host}
        </ExternalLink>
      </p>
    )}
    {cover && (
      <Image
        src={cover.src}
        alt={cover.alt}
        widths={[720, 1440]}
        sizes="(min-width: 42rem) 42rem, 100vw"
        class="mt-10 w-full rounded-2xl border"
      />
    )}
  </Fragment>
  <Content />
</Entry>
