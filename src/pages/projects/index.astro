---
import Base from "../../layouts/Base.astro";
import CategoryIndex from "../../components/CategoryIndex.astro";
import { published } from "../../lib/collections";
import { SITE_NAME } from "../../lib/site";

const projects = await published("projects");
---

<Base
  title={`Projects — ${SITE_NAME}`}
  description="Things I've built, and where to find them."
>
  <h1 class="enter text-3xl font-medium tracking-tight sm:text-4xl">
    Projects
  </h1>
  <CategoryIndex
    entries={projects.map((project) => ({
      href: `/projects/${project.id}/`,
      ...project.data,
    }))}
  />
</Base>
