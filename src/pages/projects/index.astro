---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title="Projects — Jamie Thompson"
  description="Things I have designed and built."
>
  <h1>Projects</h1>
  <p>Things I have designed and built.</p>
  {projects.length === 0 && <p class="muted">First project in progress.</p>}
  <ul>
    {projects.map((project) => (
      <li>
        <a href={`/projects/${project.id}/`}>{project.data.title}</a>
        <p class="muted">{project.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
